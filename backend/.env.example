# ---- VELoop Rewards API -------------------------------------------------
# Copy to `.env` and fill in real values. Never commit a filled-in `.env`.

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/veloop_rewards

# Signs user JWTs. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# HMAC key that binds a challenge to its owner and expiry.
# Must differ from JWT_SECRET. Generate the same way as above.
SERVER_SECRET=replace-me-with-a-different-long-random-string

# API port.
PORT=5000

# Database used by `npm test`. Kept separate so tests never touch dev data.
TEST_MONGO_URI=mongodb://127.0.0.1:27017/veloop_rewards_test
